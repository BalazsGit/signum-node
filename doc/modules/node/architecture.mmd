---
description: Node module component, config resolution, logging, and multi-profile runtime architecture diagram
---
flowchart BT
    subgraph Node_Module["Node Module"]
        ProfileConfig[ProfileConfig]
        LifecycleMgr[NodeLifecycleManager]
        LoggingProv[NodeLoggingProvider]

        subgraph Profile_Runtime["Profile Runtime (per profile)"]
            direction TB
            NodeProfile[NodeProfile<br/>(Config Entity)]
            NodeProfileRuntime[NodeProfileRuntime<br/>(State Container)]
            StateMachine[LifecycleStateMachine<br/>(State Pattern)]
            MetricCollector[ProfileMetricCollector<br/>(Per-Profile Metrics)]

            subgraph CoreContext["NodeCoreContext<br/>(Isolated Resources)"]
                direction TB
                DbContext[DbContext]
                StoreDeps[StoreDependencies]
                PropertyService[PropertyService]
                Blockchain[Blockchain]
                Stores[*Store Instances]
                Services[*Service Instances]
                ThreadPool[ThreadPool]
                WebServer[WebServer]
            end
        end

        NodeProfile -->|composition 1:1| NodeProfileRuntime
        NodeProfileRuntime -->|owns| StateMachine
        NodeProfileRuntime -->|owns| MetricCollector
        NodeProfileRuntime -->|owns| CoreContext
    end

    subgraph Config_System["Config System"]
        ConfigPath[ModuleConfigPath]
        PPL[PropertiesProfileLoader]
        LogMgr[LoggingProfileManager]
        ProfileBuilder[NodeProfile.Builder<br/>(Builder Pattern)]
    end

    subgraph Resources["Resources JAR"]
        NodeDef[/conf/node/profiles/ node-default.properties]
        LogDef[/conf/node/logging/ logging-default.properties]
    end

    subgraph Runtime_Config["Runtime User Config"]
        UserNode[conf/node/profiles/ {profile}.properties]
        UserLog[conf/node/logging/logging.properties]
        ProfilesJson[settings/profiles.json<br/>(loggingAssociations + tabOrder)]
    end

    subgraph Logging_Framework["Logging Framework"]
        direction TB
        ModuleLogger[ModuleLogger Interface]
        LoggerImpl[LoggerImpl Abstract]
        SystemLogger[SystemLogger Singleton]
        ProfileLogger[ProfileLogger Per-Profile]

        ModuleLogger -.-> LoggerImpl
        LoggerImpl --> SystemLogger
        LoggerImpl --> ProfileLogger
    end

    subgraph New_Bridge["JUL→SystemLogger Bridge"]
        direction TB
        SysRouterHandler[SystemLogRouterHandler]
        JulBridge[SLF4J → slf4j-jdk14 → JUL LogManager]
    end

    subgraph Legacy_Deprecated["Legacy - Deprecated"]
        direction TB
        ProfileLogRouter[ProfileLogRouter @Deprecated]
        ProfileThreadCtx[ProfileThreadContext @Deprecated]
        ProfileLogCtx[ProfileLogContext @Deprecated]
    end

    subgraph GUI_Consoles["GUI Consoles"]
        SysConsole[SystemConsoleSubscriber]
        ProfConsole[ProfileConsoleSubscriber]
        NodeConsolePanel[NodeConsolePanel TextAreaOutputStream]
    end

    %% Profile Loading Flow
    PPL -->|discovers| UserNode
    PPL -->|syncs defaults| NodeDef
    PPL -->|creates via factory| ProfileBuilder
    ProfileBuilder -->|builds| NodeProfile
    ProfilesJson -->|loggingAssociation| NodeProfile

    %% Config Resolution
    LifecycleMgr -->|manages| NodeProfile
    LifecycleMgr -->|uses| PPL
    LoggingProv --> LogMgr
    ConfigPath --> NodeDef
    ConfigPath --> LogDef
    ConfigPath --> UserNode
    ConfigPath --> UserLog

    %% New JUL→SystemLogger Bridge (Active)
    JulBridge -->|publish(LogRecord)| SysRouterHandler
    SysRouterHandler -->|"LogEvent.from()"| SystemLogger

    %% Logging Architecture
    CoreContext --> ProfileLogger
    SystemLogger --> SysConsole
    ProfileLogger --> ProfConsole
    ProfileLogger -.->|forwardToSystem| SystemLogger

    %% Bootstrap Logs
    NodeConsolePanel -->|"bootstrap logs"| ProfConsole

    %% Legacy Bridge (Deprecated - still active for external libs)
    JulBridge -.->|legacy handler| ProfileLogRouter
    ProfileLogRouter -.->|globalSubscribers| SysConsole
    ProfileThreadCtx -.->|MDC Routing| ProfileLogRouter
    ProfileLogCtx -.->|Subscriber Registry| ProfileLogRouter

    %% CoreContext Internal Dependencies (Phase 10e: StoreDependencies added)
    DbContext --> PropertyService
    DbContext --> StoreDeps
    PropertyService --> StoreDeps
    StoreDeps --> Blockchain
    StoreDeps --> Stores
    Blockchain --> Stores
    Stores --> Services
    Services --> ThreadPool
    Services --> WebServer