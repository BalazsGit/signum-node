/*.iml
/dist
/tmp
/temp
.idea
*.log
/conf/logging.properties
/conf/node.properties
/conf/node.properties
_config.yml
/html/ui/doc/*
/html/ui/phoenix/*
/html/ui/classic/*
!/html/ui/phoenix/README.md
!/html/ui/classic/README.md
target
*.prefs
.project
.classpath
/burst_db/*
/db/*
